+func genBoost(cfg *config.AIConfig, msg openai.ChatCompletionMessage, confRole model.Role) (openai.ChatCompletionMessage, error) {
+
+	if confRole == model.GENERATOR {
+		prompt := openai.ChatCompletionMessage{Role: sys, Content: "# 任务：规范化用户的请求语句\n" +
+			"\n" +
+			"## 任务目标：\n" +
+			"根据用户的查询，生成一个简洁、明确的编写shell脚本需求，步骤清晰。\n" +
+			"\n" +
+			"## 任务步骤：\n" +
+			"1. 表明自己需要生成可以在linux上运行的bash shell 脚本\n" +
+			"2. 列出用户遇到的问题\n3. 分步说明需要怎么解决\n" +
+			"4. 总结到请根据上述文本生成脚本\n" +
+			"## **输出格式要求**：\n" +
+			"markdown\n" +
+			"## 用户的输入:\n" +
+			msg.Content}
+		gptCfg := openai.DefaultConfig(cfg.ApiKey)
+		gptCfg.BaseURL = cfg.BaseURL // 例如 SiliconFlow 服务
+		customClient := openai.NewClientWithConfig(gptCfg)
+
+		req := openai.ChatCompletionRequest{
+			Model:    cfg.Model,
+			Messages: []openai.ChatCompletionMessage{prompt},
+		}
+
+		resp, err := customClient.CreateChatCompletion(context.Background(), req)
+		if err != nil {
+			return openai.ChatCompletionMessage{}, fmt.Errorf("rearrage ask commit ERROR: %v", err)
+
+		}
+		generatedQuieryMsg :=
+			openai.ChatCompletionMessage{
+				Role:    usr,
+				Content: resp.Choices[0].Message.Content,
+			}
+		return generatedQuieryMsg, nil
+
+	}
+	return msg, fmt.Errorf("unknown role %v", confRole)
 }
